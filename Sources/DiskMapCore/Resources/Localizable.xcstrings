        }
      }
    },
    "Airy cannot read its settings; nothing runs until you check them in the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Airy cannot read its settings; nothing runs until you check them in the app."

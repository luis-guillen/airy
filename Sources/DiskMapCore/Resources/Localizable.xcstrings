    "Airy could not read what Homebrew would do when uninstalling it; the app is moved to the Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Airy could not read what Homebrew would do when uninstalling it; the app is moved to the Trash."

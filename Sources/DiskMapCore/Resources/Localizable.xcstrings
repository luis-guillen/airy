          "stringUnit": {
            "state": "translated",
            "value": "Airy no pudo leer qué haría Homebrew al desinstalarla; la app se mueve a la Papelera."
          }
        }
      }
    },
    "Airy does not know how to check “%@” yet; it is not touched.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Airy does not know how to check “%@” yet; it is not touched."

{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ %@ folders are skipped right now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Ahora se omiten %2$@ carpetas."
          }
        }
      }
    },
    "%@ (not connected)" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",

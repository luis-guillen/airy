    },
    "About %@ will be freed." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se liberarán unos %@."
          }
        }
      }
    },
    "About Airy" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acerca de Airy"
          }
        }
      }
    },
    "Add Folder…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir carpeta…"
          }
        }
      }
    },
    "Add it to opencode.json." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añádelo a opencode.json."
          }
        }
      }
    },
    "Add it to ~/.codex/config.toml." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añádelo a ~/.codex/config.toml."
          }
        }
      }
    },
    "Add to Claude Code" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadir a Claude Code"
          }
        }
      }
    },
    "Added to Claude Code" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añadido a Claude Code"
          }
        }
      }
    },
    "After you turn it on in System Settings › Privacy & Security › Full Disk Access, come back to Airy and the status updates." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando lo actives en Ajustes del Sistema › Privacidad y seguridad › Acceso total al disco, vuelve a Airy y el estado se actualizará."
          }
        }
      }
    },
    "Agent Activity" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actividad de los agentes"
          }
        }
      }
    },
    "Agents & MCP" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agentes y MCP"
          }
        }
      }
    },
    "Airy" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy"
          }
        }
      }
    },
    "Airy adapts ideas and path lists from Mole (GPL-3.0). It contains no Mole code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy adapta ideas y listas de rutas de Mole (GPL-3.0). No contiene código de Mole."
          }
        }
      }
    },
    "Airy and agents never select, clean or move these to the Trash." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy y los agentes nunca los seleccionan, limpian ni mueven a la Papelera."
          }
        }
      }
    },
    "Airy and agents won’t touch anything you choose." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy y los agentes no tocarán nada de lo que elijas."
          }
        }
      }
    },
    "Airy can measure everything, including Mail, Messages and the Trash." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy puede medirlo todo, incluidos Mail, Mensajes y la Papelera."
          }
        }
      }
    },
    "Airy can’t read the Trash, so it doesn’t know how much it takes up." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy no puede leer la Papelera, así que no sabe cuánto ocupa."
          }
        }
      }
    },
    "Airy can’t see the whole disk" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy no puede ver todo el disco"
          }
        }
      }
    },
    "Airy completed the operation, but %@. The exportable log may be incomplete." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy hizo la operación, pero %@. El registro exportable puede estar incompleto."
          }
        }
      }
    },
    "Airy couldn’t read everything inside: it may take up more." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy no pudo leer todo lo que hay dentro: puede ocupar más."
          }
        }
      }
    },
    "Airy deletes the record of what it and your agents cleaned. This can’t be undone. Your files and the Trash aren’t touched." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy borra el registro de lo que limpiaron Airy y tus agentes. No se puede deshacer. Tus archivos y la Papelera no se tocan."
          }
        }
      }
    },
    "Airy didn’t understand that link, so it did nothing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy no entendió ese enlace, así que no hizo nada."
          }
        }
      }
    },
    "Airy doesn’t show degrees: reading them requires private Apple interfaces that can break." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy no muestra grados: leerlos exige interfaces privadas de Apple que pueden romperse."
          }
        }
      }
    },
    "Airy forgets its saved scans of every disk and scans again the next time it opens. Your files aren’t touched, and the cleanup history stays." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy olvida los escaneos guardados de todos los discos y vuelve a escanear la próxima vez que se abra. Tus archivos no se tocan y el historial de limpieza se conserva."
          }
        }
      }
    },
    "Airy has no “free up RAM” button: macOS already manages memory and those buttons don’t help. What really helps is quitting what uses the most." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy no tiene botón de «liberar RAM»: macOS ya gestiona la memoria y esos botones no ayudan. Lo que alivia de verdad es cerrar lo que más consume."
          }
        }
      }
    },
    "Airy is busy; ask again in a moment." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy está ocupada; vuelve a pedirlo en un momento."
          }
        }
      }
    },
    "Airy is busy; restart it when the current task has finished." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy está ocupado; reinícialo cuando termine la tarea en curso."
          }
        }
      }
    },
    "Airy never opens these folders when it scans, so their contents don’t appear in the map. Changes apply from the next scan." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy nunca abre estas carpetas al escanear, así que su contenido no aparece en el mapa. Los cambios se aplican desde el próximo escaneo."
          }
        }
      }
    },
    "Airy only lets you know; remove them yourself in System Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy solo avisa; quítalos tú en Ajustes del Sistema."
          }
        }
      }
    },
    "Airy scans every disk again the next time it opens." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy vuelve a escanear todos los discos la próxima vez que se abra."
          }
        }
      }
    },
    "Airy tells you what it is and how to do it yourself; there’s no delete button here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy te dice qué es y cómo hacerlo tú; aquí no hay botón de borrar."
          }
        }
      }
    },
    "Airy won’t delete this whole folder, but you can clean what’s inside. Click to open it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy no borrará la carpeta entera, pero sí puedes limpiar lo que hay dentro. Haz clic para entrar."
          }
        }
      }
    },
    "Airy won’t scan the folders you choose." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Airy no escaneará las carpetas que elijas."
          }
        }
      }
    },
    "Airy’s menus, buttons and messages." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los menús, botones y mensajes de Airy."
          }
        }
      }
    },
    "All Kinds" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los tipos"
          }
        }
      }
    },
    "Allow agents to run safe cleanups" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir que los agentes ejecuten limpiezas seguras"
          }
        }
      }
    },
    "Also deletes what gets downloaded again or rebuilt by itself." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {

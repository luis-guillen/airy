    },
    "%@ didn’t quit. It may have unsaved work: quit it yourself and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se ha cerrado. Puede que tenga algo sin guardar: ciérrala tú y vuelve a intentarlo."

            "state" : "translated",
            "value" : "Acerca de"
          }
        }
      }
    },
    "About %@ in total. What goes to the Trash is freed when you empty it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unos %@ en total. Lo que va a la Papelera se libera al vaciarla."
          }

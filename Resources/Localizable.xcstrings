    "A link proposed moving “%@” to the Trash, but Airy can’t: %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegó por enlace una propuesta de mover «%1$@» a la Papelera, pero Airy no puede: %2$@"
          }
        }
      }
    },
    "A link proposed “%@”, but it no longer appears in Cleanup." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegó por enlace una propuesta de «%@», pero ya no aparece en Limpieza."
          }
        }
      }
    },
    "A link proposed “%@”, but it’s “Don't delete”: Airy doesn’t offer it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llegó por enlace una propuesta de «%@», pero es «No tocar»: Airy no lo ofrece."
          }
        }
      }
    },
    "A newer scan is shown as it is." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un escaneo más reciente se muestra tal cual."
          }
        }
      }
    },
